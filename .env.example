# ==========================================
# ORTAM DEĞİŞKENLERİ — ŞABLON
#
# Bu dosya git'e girer ve GERÇEK DEĞER İÇERMEZ; aşağıdakiler
# yer tutucudur. Kurulum için kopyalayıp doldurun:
#
#     cp .env.example .env
#
# Gerçek değerler .env dosyasına yazılır ve .gitignore ile
# git'in dışında tutulur.
# ==========================================

# --- MSSQL ---
MSSQL_HOST=mssql
MSSQL_PORT=1433
MSSQL_USER=sa
MSSQL_SA_PASSWORD=DegistirinGuclu.Sifre1
MSSQL_DATABASE=master

# --- MongoDB ---
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_ROOT_USERNAME=kullanici
MONGO_ROOT_PASSWORD=DegistirinGuclu.Sifre1
MONGO_DATABASE=gorev_yoneticisi

# --- Frontend ---
# Tarayıcıdan erişilen adres olmalı (compose ağı değil, bkz. README)
VITE_API_URL=http://localhost:8000

# --- JWT (Oturum Anahtarı) ---
# Kendi anahtarınızı üretin:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=buraya-uretilen-rastgele-anahtari-yazin
JWT_ALGORITHM=HS256
# Access token kısa ömürlüdür; çalınsa bile penceresi dardır.
JWT_EXPIRE_MINUTES=15
# Refresh token httpOnly çerezde taşınır ve bu süre kadar yaşar.
REFRESH_TOKEN_EXPIRE_DAYS=30
# HTTPS arkasında true yapın: çerez yalnızca şifreli bağlantıda gider.
COOKIE_SECURE=false

# --- Giriş Hız Sınırlama ---
# Bir kullanıcı adına, belirtilen süre içinde izin verilen başarısız deneme.
LOGIN_MAX_ATTEMPTS=5
# Aynı IP'den izin verilen toplam başarısız deneme (NAT için daha yüksek).
LOGIN_MAX_ATTEMPTS_PER_IP=20
# Sayım penceresi (dakika). Pencere kayar; en eski denemeler düşer.
LOGIN_WINDOW_MINUTES=15

# --- Ters Vekil ---
# X-Forwarded-For başlığına güvenilsin mi? Yalnızca uygulama bir ters vekil
# (nginx, Traefik, bulut yük dengeleyici) ARKASINDA çalışıyorsa "true" yapın.
# Doğrudan erişimde açık bırakmak, IP başına hız sınırını işlevsiz kılar:
# istemci başlığı kendisi uydurabilir.
TRUST_PROXY=false

# --- CORS ---
# Virgülle ayrılmış köken listesi. Çerez tabanlı oturum kullanıldığı
# için "*" KULLANILAMAZ; adresler tek tek yazılmalıdır.
# Telefondan LAN üzerinden erişecekseniz o adresi de ekleyin:
#   ...,http://192.168.1.20:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
